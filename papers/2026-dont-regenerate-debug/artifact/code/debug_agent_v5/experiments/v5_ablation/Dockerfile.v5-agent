FROM swr.cn-south-1.myhuaweicloud.com/ascendhub/cann:8.5.0-910b-ubuntu22.04-py3.11

ARG NODE_VERSION=22.23.1

RUN curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-arm64.tar.xz" \
      -o /tmp/node.tar.xz \
    && mkdir -p /opt/node-v22 \
    && tar -xJf /tmp/node.tar.xz -C /opt/node-v22 --strip-components=1 \
    && rm -f /tmp/node.tar.xz \
    && ln -sf /opt/node-v22/bin/node /usr/local/bin/node \
    && ln -sf /opt/node-v22/bin/npm /usr/local/bin/npm \
    && ln -sf /opt/node-v22/bin/npx /usr/local/bin/npx \
    && npm install -g @anthropic-ai/claude-code@2.1.204

ENV PIP_INDEX_URL=https://mirrors.huaweicloud.com/repository/pypi/simple

RUN python3 -m pip install --no-cache-dir \
      torch==2.10.0 \
      torch_npu==2.10.0 \
      numpy==1.26.4 \
      scipy==1.17.1 \
      psutil==7.2.2 \
      protobuf==3.20.0 \
      attrs==26.1.0 \
      cloudpickle==3.1.2 \
      decorator==5.3.1 \
      PyYAML==6.0.3 \
      requests==2.34.2 \
      six==1.17.0 \
      sympy==1.14.0 \
      typing_extensions==4.16.0

RUN ln -sf /opt/node-v22/bin/claude /usr/local/bin/claude

CMD ["sleep", "infinity"]
